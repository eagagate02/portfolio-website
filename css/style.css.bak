/* =============================
   Base styles
   ============================= */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
  background-color: #f9fafb;
  line-height: 1.6;
}

a {
  color: inherit;
}

/* =============================
   Header and navigation
   ============================= */
.site-header {
  background-color: #111827;
  color: white;
  padding: 20px 24px;
}

.navbar {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
}

.brand h1 {
  margin: 0;
  line-height: 1.1;
}

.brand p {
  margin: 8px 0 0;
  color: #d1d5db;
}

.nav-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.nav-links a {
  text-decoration: none;
  font-weight: 600;
}

.nav-links a:hover,
.nav-links a:focus {
  color: #facc15;
}

/* =============================
   Hero / About
   ============================= */
.hero {
  max-width: 1100px;
  margin: 0 auto;
  padding: 72px 24px;
}

.hero h2 {
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 48px;
  line-height: 1.1;
}

.hero p {
  max-width: 680px;
  margin-bottom: 0;
  font-size: 20px;
}

/* =============================
   Reusable sections
   ============================= */
.section {
  max-width: 1100px;
  margin: 0 auto;
  padding: 56px 24px;
}

.section-title {
  margin-top: 0;
  margin-bottom: 24px;
  font-size: 32px;
  line-height: 1.2;
}

/* =============================
   Skills
   ============================= */
.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}

.skill-card {
  flex: 1 1 220px;
  background-color: white;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 20px;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.skill-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
}

/* =============================
   Project grid
   ============================= */
.projects-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
}

.project-card {
  flex: 1 1 280px;
  background-color: white;
  border: 1px solid #e5e7eb;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.10);
}

.project-card h3 {
  margin-top: 0;
  margin-bottom: 10px;
  color: #111827;
}

.project-card p {
  margin-top: 0;
  margin-bottom: 20px;
}

/* =============================
   Reusable button
   ============================= */
.btn {
  display: inline-block;
  border: none;
  border-radius: 999px;
  padding: 12px 20px;
  background-color: #2563eb;
  color: white;
  font: inherit;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
}

.btn:hover,
.btn:focus {
  background-color: #1d4ed8;
}

/* =============================
   Contact form
   ============================= */
.contact-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
  max-width: 640px;
}

.contact-form label {
  font-weight: 600;
}

.contact-form input,
.contact-form textarea {
  width: 100%;
  padding: 12px 14px;
  border: 1px solid #d1d5db;
  border-radius: 10px;
  background-color: white;
  font: inherit;
}

.contact-form input:focus,
.contact-form textarea:focus {
  outline: 3px solid rgba(37, 99, 235, 0.20);
  border-color: #2563eb;
}

.contact-form .btn {
  align-self: flex-start;
}

/* =============================
   Footer
   ============================= */
.site-footer {
  background-color: #111827;
  color: white;
  padding: 32px 24px;
  text-align: center;
}

.site-footer p {
  margin: 6px 0;
}

.site-footer a {
  margin: 0 8px;
  color: #facc15;
  text-decoration: none;
}

.site-footer a:hover,
.site-footer a:focus {
  text-decoration: underline;
}

/* =============================
   Responsive layout
   ============================= */
@media (max-width: 700px) {
  .navbar {
    flex-direction: column;
    align-items: flex-start;
  }

  .nav-links {
    gap: 12px;
  }

  .hero,
  .section {
    padding-left: 20px;
    padding-right: 20px;
  }

  .hero h2 {
    font-size: 38px;
  }

  .hero p {
    font-size: 18px;
  }
}